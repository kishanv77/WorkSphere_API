### WorkSphere API smoke tests (VS Code "REST Client" extension).
### Run requests top to bottom. Tokens/IDs are captured into variables.
### Use unique slugs/emails per run, or expect 409 on re-registration.

@baseUrl = http://127.0.0.1:8080
@password = Local-Dev-Password-123

### Health
GET {{baseUrl}}/actuator/health

### 1. Register tenant A
POST {{baseUrl}}/api/v1/auth/register-tenant
Content-Type: application/json

{
  "tenantName": "Tenant A",
  "tenantSlug": "tenant-a",
  "firstName": "Alice",
  "lastName": "Admin",
  "email": "alice@tenant-a.test",
  "password": "{{password}}"
}

### 2. Login tenant A
# @name loginA
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{ "email": "alice@tenant-a.test", "password": "{{password}}" }

###
@tokenA = {{loginA.response.body.accessToken}}

### 3. Me
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{tokenA}}

### 4. Create project
# @name createProject
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "name": "Website Redesign", "description": "Q4 launch" }

###
@projectId = {{createProject.response.body.id}}

### 5. List projects
GET {{baseUrl}}/api/v1/projects
Authorization: Bearer {{tokenA}}

### 6. Get project
GET {{baseUrl}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{tokenA}}

### 7. Update project
PATCH {{baseUrl}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "name": "Website Redesign v2", "description": "Updated" }

### 8. Create task
# @name createTask
POST {{baseUrl}}/api/v1/tasks
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "projectId": "{{projectId}}",
  "title": "Draft wireframes",
  "priority": "HIGH",
  "dueDate": "2026-12-01"
}

###
@taskId = {{createTask.response.body.id}}

### 9. List tasks (filters: projectId, status, assigneeId)
GET {{baseUrl}}/api/v1/tasks?projectId={{projectId}}&status=TODO
Authorization: Bearer {{tokenA}}

### 10. Get task
GET {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{tokenA}}

### 11. Update task
PATCH {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "title": "Draft wireframes (rev 2)", "priority": "MEDIUM" }

### 12. Change task status
PATCH {{baseUrl}}/api/v1/tasks/{{taskId}}/status
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "status": "IN_PROGRESS" }

### 13. Archive project
PATCH {{baseUrl}}/api/v1/projects/{{projectId}}/archive
Authorization: Bearer {{tokenA}}

### ---- Cross-tenant isolation ----
### 14. Register tenant B
POST {{baseUrl}}/api/v1/auth/register-tenant
Content-Type: application/json

{
  "tenantName": "Tenant B",
  "tenantSlug": "tenant-b",
  "firstName": "Bob",
  "lastName": "Admin",
  "email": "bob@tenant-b.test",
  "password": "{{password}}"
}

### 15. Login tenant B
# @name loginB
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{ "email": "bob@tenant-b.test", "password": "{{password}}" }

###
@tokenB = {{loginB.response.body.accessToken}}

### 16. B lists projects -> expect []
GET {{baseUrl}}/api/v1/projects
Authorization: Bearer {{tokenB}}

### 17. B reads A's project -> expect 404
GET {{baseUrl}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{tokenB}}

### 18. B updates A's project -> expect 404
PATCH {{baseUrl}}/api/v1/projects/{{projectId}}
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{ "name": "Hijacked" }

### 19. B archives A's project -> expect 404
PATCH {{baseUrl}}/api/v1/projects/{{projectId}}/archive
Authorization: Bearer {{tokenB}}

### 20. B reads A's task -> expect 404
GET {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{tokenB}}

### 21. B changes A's task status -> expect 404
PATCH {{baseUrl}}/api/v1/tasks/{{taskId}}/status
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{ "status": "DONE" }

### 22. B creates a task in A's project -> expect 404
POST {{baseUrl}}/api/v1/tasks
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{ "projectId": "{{projectId}}", "title": "Intruder" }

### 23. B lists tasks -> expect []
GET {{baseUrl}}/api/v1/tasks
Authorization: Bearer {{tokenB}}
### ---- User management ----
### 24. A creates a member
# @name createMember
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{ "firstName": "Mia", "lastName": "Member", "email": "mia@tenant-a.test", "password": "{{password}}" }

###
@memberId = {{createMember.response.body.id}}

### 25. List users
GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{tokenA}}

### 26. Member logs in
# @name loginMember
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{ "email": "mia@tenant-a.test", "password": "{{password}}" }

###
@tokenM = {{loginMember.response.body.accessToken}}

### 27. Member creates a user -> expect 403
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{tokenM}}
Content-Type: application/json

{ "firstName": "X", "lastName": "Y", "email": "x@tenant-a.test", "password": "{{password}}" }

### 28. B reads A's member -> expect 404
GET {{baseUrl}}/api/v1/users/{{memberId}}
Authorization: Bearer {{tokenB}}

### 29. A deactivates member
PATCH {{baseUrl}}/api/v1/users/{{memberId}}/deactivate
Authorization: Bearer {{tokenA}}

### ---- Roles and pagination ----
### 30. Member creates a project -> expect 403
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{tokenM}}
Content-Type: application/json

{ "name": "Not allowed" }

### 31. Paged lists (X-Total-Count header holds the total)
GET {{baseUrl}}/api/v1/projects?page=0&size=2
Authorization: Bearer {{tokenA}}

###
GET {{baseUrl}}/api/v1/tasks?page=0&size=5&status=TODO
Authorization: Bearer {{tokenA}}

###
GET {{baseUrl}}/api/v1/users?page=0&size=10
Authorization: Bearer {{tokenA}}